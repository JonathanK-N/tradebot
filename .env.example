# Copier en .env (chmod 600) et remplir. Ce fichier-ci ne contient AUCUN vrai secret.

# --- MetaTrader 5 (VPS Windows uniquement) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Telegram (bot créé via @BotFather) ---
TELEGRAM_BOT_TOKEN=
# ton chat_id (voir `tradebot telegram-whoami`), plusieurs séparés par des virgules
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Sécurité ---
# généré par `tradebot totp-setup`
TOTP_SECRET=
# jeton du dashboard : `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_TOKEN=

# --- Infrastructure ---
# Sur le VPS Linux, docker-compose construit DATABASE_URL et REDIS_URL à partir de ces mots de passe.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Sur le VPS WINDOWS uniquement : URL complète vers le Redis du VPS Linux via Tailscale
# REDIS_URL=redis://:MOT_DE_PASSE@100.x.y.z:6379/0

# --- Dead man's switch (https://healthchecks.io, gratuit) ---
HEALTHCHECK_URL=

# --- Verrou compte réel (NE PAS remplir avant validation de la démo) ---
# TRADEBOT_ALLOW_REAL_MONEY=
